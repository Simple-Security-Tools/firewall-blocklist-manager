# Using DENY_ONLY forces the script to only export firewall deny lists
# which can then be kept in sync with Entra Conditional Access Policy Block Lists
DENY_ONLY=true
DEFAULT_EXPIRY=30
MAX_EXPIRY=32
FILE_OUTPUT_DENY=palo-blocks.txt
FILE_OUTPUT_ALLOW=palo-allows.txt

# required for entra sync
TENANT_ID=
CLIENT_ID=
SECRET=
SECRET_ID=
BLOCKLIST_NAMED_LOCATION_ID=